{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)"
        },
        "state": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "inbox": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/meta').exists()"
          }
        },
        "presence": {
          "$pid": {
            ".write": "auth != null"
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.child('kind').isString() && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 300)) && (!newData.child('audio').exists() || (newData.child('audio').isString() && newData.child('audio').val().length <= 400000))"
          }
        },
        "call": {
          "peers": {
            "$pid": {
              ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || !newData.exists())"
            }
          },
          "sig": {
            "$to": {
              ".write": "auth != null && !newData.exists()",
              "$msg": {
                ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || !newData.exists())"
              }
            }
          }
        }
      }
    },
    "hostpriv": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)"
      }
    }
  }
}